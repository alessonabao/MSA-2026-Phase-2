.vscode/settings.json
.DS_Store

# .NET (covers backend/bin, backend/obj, and backend.Tests/bin, backend.Tests/obj alike)
software/demo/backend/**/bin/
software/demo/backend/**/obj/

# User-uploaded profile pictures - runtime content, not source. Lives outside backend/ itself
# (see Program.cs) so `dotnet watch`'s file watcher never sees it in the first place.
software/demo/uploads/

# Node
software/demo/frontend/node_modules/
software/demo/frontend/dist/
software/demo/frontend/dist-ssr/

# Frontend build output - vite.config.ts writes it into backend/wwwroot so the published
# backend can serve it, but it's generated (npm run build), not source. Keep the folder
# tracked via .gitkeep so `dotnet run`/deploy pipelines that expect it to exist still work
# on a fresh clone before the frontend has been built.
software/demo/backend/wwwroot/*
!software/demo/backend/wwwroot/.gitkeep

# Environment
.env*
.DS_Store
.vscode

# Database
software/demo/backend/appsettings.json
software/demo/backend/fencingclub.db
software/demo/backend/fencingclub.db-shm
software/demo/backend/fencingclub.db-wal

# E2E test database - reset and reseeded on every Playwright run (see webServer in
# software/demo/frontend/playwright.config.ts), never persisted between runs.
software/demo/backend/fencingclub.e2e.db
software/demo/backend/fencingclub.e2e.db-shm
software/demo/backend/fencingclub.e2e.db-wal

# Playwright
test-results/
playwright-report/

# Frontend folder
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sw?

# Playwright
software/demo/frontend/test-results/
software/demo/frontend/playwright-report/
software/demo/frontend/blob-report/
software/demo/frontend/playwright/.cache/
software/demo/frontend/playwright/.auth/
